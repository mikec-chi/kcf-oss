  "familyPolicies": {
    "_comment": "Explicit completeness-policy decision for each grammar construct family that has no obligation above. Distinguishes a DELIBERATE non-applicability from an unfinished policy, so meta-coverage (kcf coverage-meta) can tell a designed gap from a missing one. Decisions: 'conditional' (completeness is enforced elsewhere or only under a specific construct), 'intentionally-none' (an optional or emitter-tier dimension with no required completeness obligation by design).",
    "ANALYTICS": {"decision": "conditional", "reason": "Analytics completeness is carried by the analytics-platform profile's MEASURE + source-INFORMATION obligations; the ANALYTICS emitter dimension (reports/dashboards) is presentation and has no separate required completeness obligation."},
    "LINEAGE": {"decision": "conditional", "reason": "Lineage integrity is enforced by analyzer validity rules (lineage.cycle / lineage.binding.unique / lineage.cost.nonnegative); there is no separate required completeness obligation."},
    "DESIGN": {"decision": "intentionally-none", "reason": "DESIGN is an emitter/presentation dimension; the generated UI is driven by ENTITY/ACTION/EXPERIENCE, not gated by a required DESIGN completeness obligation."},
    "EXPERIENCE": {"decision": "intentionally-none", "reason": "EXPERIENCE (UI/flows) is emitter-tier; frontend generation derives from ENTITY/ACTION, so no required experience completeness obligation is imposed."},
    "INTENT": {"decision": "intentionally-none", "reason": "INTENT (goals/objectives/preferences) is advisory context for reasoning, not a required completeness obligation on a domain model."},
    "LOGIC": {"decision": "intentionally-none", "reason": "LOGIC (modal propositions) is an optional reasoning construct used only by domains that model formal logic; no required completeness obligation."},
    "MATH": {"decision": "intentionally-none", "reason": "MATH (formulae/models) is an optional quantitative construct; no required completeness obligation on a general domain model."},
    "SPATIAL": {"decision": "intentionally-none", "reason": "SPATIAL is an optional dimension used only by location-aware domains; no required completeness obligation."}
  }
}
