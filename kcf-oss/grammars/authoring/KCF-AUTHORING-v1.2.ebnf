(* KCF ergonomic domain-authoring grammar v1.2. *)
authoring-model = [ "kcf" ], "model", identifier,
                  [ "profile", identifier ], "{",
                  [ namespace-decl ], { profile-use },
                  { pattern-claim },
                  authoring-declaration, { authoring-declaration }, "}" ;
namespace-decl = "namespace", qualified-name, ";" ;
profile-use = "use", identifier, ";" ;
pattern-claim = ( "implements" | "excludes" ), qualified-name, ";" ;
authoring-declaration = concept-decl | organization-decl | information-decl
                      | rule-decl | policy-decl | reasoning-decl
                      | assertion-decl | identity-resolution-decl
                      | knowledge-query-decl | relationship-decl
                      | lifecycle-decl | action-decl | collection-decl | unit-decl
                      | authority-decl | process-decl | calendar-decl | route-decl
                      | proposition-decl | predicate-decl | math-decl | allocation-decl
                      | profile-block ;
(* Operational + emitter PROFILE blocks (ergonomic form of the profile grammars under
   grammars/profiles/). Each element projects into ir[<section>][<collection>];
   references resolve by local id. Element bodies are `<key> <value>;` lines. *)
profile-block = profile-section, "{", { profile-element }, "}" ;
profile-section = "integration" | "security" | "lineage" | "architecture"
                | "experience" | "design" | "analytics" | "ai" ;
profile-element = identifier, identifier, "{", { profile-member }, "}" ;
profile-member = identifier, scalar, ";" | knowledge-metadata ;

concept-decl = concept-keyword, identifier, concept-body
             | "event", identifier, "immutable", ";" ;
concept-keyword = "entity" | "actor" | "work" | "event" | "resource"
                | "intent" | "measure" | "temporal"
                | "spatial" | "logic" | "math" ;
concept-body = "{", { concept-member }, "}" ;
concept-member = attribute-decl | reference-decl | trait-decl
               | abstract-decl | immutable-decl | kind-decl
               | capability-decl | skill-decl
               | requires-capability-decl | requires-skill-decl
               | event-member | entity-member | measure-member | actor-member
               | work-member | intent-member | temporal-member | spatial-member
               | resource-member | property-decl | specialization-decl ;
(* RFC-8 (grammar stack 1.13): a concept may specialize/refine a parent concept; the
   parent's primary kind must be preserved or legally refined. Projects onto `specializes`. *)
specialization-decl = "specializes", semantic-ref, ";" ;
attribute-decl = attribute-modifier, identifier, ":", qualified-name,
                 [ "=", scalar ], [ cardinality ], { qualifier }, ";" ;
attribute-modifier = "identity" | "required" | "optional" | "field" ;
cardinality = "one" | "many" | "set" | "zero-or-one" | "one-or-many"
            | "zero-or-many" | "optional-one" ;
qualifier = "generated" | identifier ;                       (* generated flag + free-form qualifiers *)
(* ENTITY dimension members (ergonomic form of dimensions/ENTITY-v1.0). *)
entity-member = composition-decl | named-reference-decl | embedded-collection-decl
              | lifecycle-binding-decl | constraint-decl | mutation-decl ;
composition-decl = "compose", identifier, ":", semantic-ref, cardinality,
                   [ "orphan", orphan-policy ], ";" ;
named-reference-decl = "reference", identifier, ":", semantic-ref, cardinality,
                       [ "inverse", identifier ], ";" ;
embedded-collection-decl = "collection", identifier, ":", semantic-ref, ";"
                | "collection", identifier, "of", semantic-ref, "{",
                  [ "identity", identifier, ";" ], [ "order-by", identifier, ";" ],
                  { "constraint", semantic-ref, ";" }, "}" ;
lifecycle-binding-decl = "lifecycle", semantic-ref, ";" ;    (* bind entity to its lifecycle *)
constraint-decl = "constraint", semantic-ref, ";" ;          (* inline constraint-use *)
orphan-policy = "restrict" | "cascade" | "detach" | "archive" ;
mutation-decl = "mutation", identifier, "{",
                "operation", mutation-operation, ";",
                [ "scope", mutation-scope, ";" ], [ "selection", selection, ";" ],
                { mutation-change }, { "precondition", scalar, ";" },
                { "postcondition", scalar, ";" }, { "emit", semantic-ref, ";" },
                [ "atomicity", atomicity, ";" ], [ "concurrency", concurrency, ";" ],
                [ "version-field", identifier, ";" ], [ "idempotency", identifier, ";" ], "}" ;
mutation-change = "change", identifier, [ "from", scalar, "to", scalar ], ";"
                | "add-member", identifier, ";"
                | "remove-member", identifier, ";"
                | "archive", [ identifier ], ";" ;
mutation-operation = "create" | "replace" | "update" | "patch" | "delete" | "upsert"
                   | "archive" | "assign-reference" | "add-member" | "remove-member" | "synchronize" ;
mutation-scope = "record" | "set" | "batch" | "stream" ;
selection = "identity" | "predicate" | "keys" | "partition" | "all" ;
atomicity = "atomic" | "per-record" | "best-effort" ;
concurrency = "none" | "optimistic" | "pessimistic" | "serialized" ;
reference-decl = "ref", semantic-ref, ";" ;
trait-decl = "trait", semantic-ref, ";" ;
abstract-decl = "abstract", ";" ;
immutable-decl = "immutable", ";" ;                          (* EVENT: value semantics *)
kind-decl = "kind", identifier, ";" ;                        (* dimension classifier: event-kind, actor-kind, ... *)
capability-decl = "capability", semantic-ref, ";" ;          (* ACTOR *)
skill-decl = "skill", semantic-ref, ";" ;                    (* ACTOR *)
requires-capability-decl = "requires-capability", semantic-ref, ";" ;  (* WORK *)
requires-skill-decl = "requires-skill", semantic-ref, ";" ;            (* WORK *)
(* EVENT dimension members (ergonomic form of dimensions/EVENT-v1.0). *)
event-member = "subject", semantic-ref, ";"
             | "source", semantic-ref, ";"
             | "observer", semantic-ref, ";"
             | "trigger", semantic-ref, ";"
             | "affect-lifecycle", semantic-ref, ";"
             | "evidence", semantic-ref, ";"
             | "occurrence-time", identifier, ";"
             | "detection-time", identifier, ";"
             | "correlation-key", identifier, ";"
             | "severity", scalar, ";"
             | "expectedness", identifier, ";"
             | "match", scalar, ";" ;
(* MEASURE dimension members (ergonomic form of dimensions/MEASURE-v1.0). `kind`
   reuses kind-decl with a measure-kind classifier; `subject` reuses event-member. *)
measure-member = "unit", semantic-ref, ";"
               | "scale", scale-kind, ";"
               | "calculation", semantic-ref, ";"
               | "aggregation", aggregation-kind, ";"
               | "period", semantic-ref, ";"
               | "threshold", number, ";"
               | "target", number, ";"
               | "tolerance", number, ";" ;
scale-kind = "nominal" | "ordinal" | "interval" | "ratio" ;
aggregation-kind = "sum" | "average" | "minimum" | "maximum" | "count"
                 | "distinct-count" | "none" ;
unit-decl = "unit", identifier, "{", "dimension", identifier, ";",
            [ "symbol", scalar, ";" ], [ "base", semantic-ref, ";" ],
            [ "factor", number, ";" ], "}" ;
(* ACTOR dimension members (ergonomic form of dimensions/ACTOR-v1.0). `kind` reuses
   kind-decl with an actor-kind classifier; `capability`/`skill` reuse ACTOR decls. *)
actor-member = "role", semantic-ref, ";"
             | "authority", semantic-ref, ";"
             | "responsible-for", semantic-ref, ";"
             | "accountable-for", semantic-ref, ";"
             | "member-of", semantic-ref, ";"
             | "availability", scalar, ";"
             | "communication", semantic-ref, ";" ;
authority-decl = "authority", identifier, "{", "mode", authority-mode, ";",
                 "subject", semantic-ref, ";", "target", semantic-ref, ";",
                 { "when", scalar, ";" }, [ validity-inline ], "}" ;
authority-mode = "may-perform" | "may-approve" | "may-delegate"
               | "may-escalate" | "must-not-perform" ;
(* WORK dimension members (ergonomic form of dimensions/WORK-v1.0). `kind` reuses
   kind-decl with a work-kind classifier; requires-capability/skill reuse WORK decls. *)
work-member = "performer", semantic-ref, ";"
            | "input", semantic-ref, ";"
            | "output", semantic-ref, ";"
            | "outcome", semantic-ref, ";"
            | "requires-resource", semantic-ref, ";"
            | "requires-tool", semantic-ref, ";"
            | "governed-by", semantic-ref, ";"
            | "triggered-by", semantic-ref, ";"
            | "emit", semantic-ref, ";"
            | "compensate-with", semantic-ref, ";"
            | "temporal", semantic-ref, ";"
            | "precondition", scalar, ";"
            | "postcondition", scalar, ";"
            | "completion", scalar, ";"
            | "failure", scalar, ";" ;
(* WORK-dimension process choreography (BPMN). *)
process-decl = "process", identifier, "{", { process-member }, "}" ;
process-member = "start", identifier, [ "triggered-by", semantic-ref ], ";"
               | "end", identifier, [ "outcome", semantic-ref ], ";"
               | "event", identifier, "uses", semantic-ref, ";"
               | "step", identifier, ":", semantic-ref, [ "in", identifier ], ";"
               | "gateway", identifier, ":", gateway-kind, ";"
               | "call", identifier, ":", semantic-ref, ";"
               | "flow", identifier, "->", identifier,
                 [ "when", scalar ], [ "priority", number ], ";"
               | "boundary", identifier, "on", identifier, "uses", semantic-ref, ";"
               | lane-decl ;
lane-decl = "lane", identifier, "{", "performer", semantic-ref, ";",
            { "contains", identifier, ";" }, "}" ;
gateway-kind = "exclusive" | "inclusive" | "parallel" | "event-based" ;
(* INTENT / TEMPORAL / SPATIAL dimension concept members (ergonomic forms of their
   dimension grammars; `kind` reuses kind-decl with the relevant classifier). *)
intent-member = "desired-state", scalar, ";" | "success", scalar, ";"
              | "priority", number, ";" | "stakeholder", semantic-ref, ";"
              | "measure", semantic-ref, ";" | "time-horizon", semantic-ref, ";"
              | "tradeoff", semantic-ref, "against", semantic-ref, [ "weight", number ], ";" ;
temporal-member = "start", scalar, ";" | "end", scalar, ";"
                | "duration", number, duration-unit, ";" | "recurrence", scalar, ";"
                | "calendar", semantic-ref, ";" | "timezone", scalar, ";"
                | "calculation", scalar, ";" ;
duration-unit = "millisecond" | "second" | "minute" | "hour" | "day"
              | "week" | "month" | "year" ;
spatial-member = "contained-in", semantic-ref, ";" | "adjacent-to", semantic-ref, ";"
               | "route", semantic-ref, ";" | "jurisdiction", semantic-ref, ";"
               | "geometry", geometry-kind, "[", coordinate, { [ "," ], coordinate }, "]", ";" ;
geometry-kind = "point" | "line" | "polygon" | "volume" ;
coordinate = number, number, [ number ] ;
calendar-decl = "calendar", identifier, "{", "timezone", scalar, ";",
                { "working-day", identifier, ";" }, { "holiday", scalar, ";" }, "}" ;
route-decl = "route", identifier, "{", "from", semantic-ref, ";", "to", semantic-ref, ";",
             { "via", semantic-ref, ";" }, [ "distance", number, identifier, ";" ],
             { "constraint", semantic-ref, ";" }, "}" ;
proposition-decl = "proposition", identifier, "{", "expression", scalar, ";",
                   [ "mode", modal-operator, ";" ], "}" ;
modal-operator = "necessary" | "possible" | "permitted" | "obligatory" | "known" | "believed" ;
predicate-decl = "predicate", identifier, "{", { "param", identifier, ":", qualified-name, ";" },
                 "expression", scalar, ";", "}" ;
math-decl = ( "formula" | "function" | "optimize" | "distribution" | "simulation" ),
            identifier, "{", { math-member }, "}" ;
math-member = "result", semantic-ref, ";" | "returns", qualified-name, ";"
            | "family", identifier, ";" | "model", semantic-ref, ";"
            | "expression", scalar, ";" | "param", identifier, ":", qualified-name, ";"
            | "objective", ( "minimize" | "maximize" ), scalar, ";"
            | "variable", identifier, ";" | "constraint", scalar, ";"
            | "trials", number, ";" | "seed", number, ";" | property-decl ;
(* RESOURCE dimension members (ergonomic form of dimensions/RESOURCE-v1.0). `kind`
   reuses kind-decl with a resource-kind classifier. *)
resource-member = "capacity", number, [ identifier ], ";"
                | "availability", scalar, ";"
                | "location", semantic-ref, ";"
                | "owner", semantic-ref, ";"
                | "allocation-policy", semantic-ref, ";"
                | "reservation-policy", semantic-ref, ";"
                | "consumption", consumption-mode, ";"
                | "replenishment", semantic-ref, ";"
                | "cost", semantic-ref, ";" ;
consumption-mode = "consume" | "reserve" | "borrow" | "share" ;
allocation-decl = "allocation", identifier, "{", "resource", semantic-ref, ";",
                  "consumer", semantic-ref, ";", "quantity", number, ";",
                  [ "reservation", semantic-ref, ";" ], [ validity-inline ], "}" ;
property-decl = identifier, scalar, ";" ;

organization-decl = "organization", identifier, "{",
                    "kind", organization-kind, ";",
                    { organization-member | knowledge-metadata }, "}" ;
organization-member = "parent", semantic-ref, ";"
                    | "member", semantic-ref, ";"
                    | "role", semantic-ref, ";"
                    | "authority-domain", semantic-ref, ";"
                    | "owns", semantic-ref, ";"
                    | "accountable-for", semantic-ref, ";"
                    | "reports", semantic-ref, "to", semantic-ref,
                      [ validity-inline ], ";"
                    | "escalation", "[", semantic-ref,
                      { "->", semantic-ref }, "]", ";" ;
organization-kind = "ORGANIZATION" | "UNIT" | "DEPARTMENT" | "TEAM"
                  | "POSITION" ;

information-decl = "information", identifier, "{",
                   "kind", information-kind, ";",
                   { information-member | knowledge-metadata }, "}" ;
information-member = "subject", semantic-ref, ";"
                   | "author", semantic-ref, ";"
                   | "source", semantic-ref, ";"
                   | "audience", semantic-ref, ";"
                   | "schema", semantic-ref, ";"
                   | "representation", identifier, ";"
                   | "confidentiality", identifier, ";"
                   | "freshness", semantic-ref, ";"
                   | "completeness", number, ";"
                   | "trust", number, ";"
                   | "field", identifier, ":", qualified-name, [ cardinality ], ";" ;
information-kind = "DOCUMENT" | "MESSAGE" | "RECORD" | "MODEL" | "EVIDENCE"
                 | "INSTRUCTION" | "REPORT" | "SEMANTIC_PACKET" ;

rule-decl = "rule", identifier, "{", "kind", rule-kind, ";",
            "condition", scalar, ";", rule-effect, { rule-effect },
            { rule-member | knowledge-metadata }, "}" ;
rule-effect = "effect", semantic-ref, ";" ;
rule-member = "applies-to", semantic-ref, ";"
            | "mode", normative-mode, ";"
            | "priority", integer, ";"
            | "conflict", conflict-strategy, ";"
            | "authority", semantic-ref, ";"
            | "exception", semantic-ref, ";"
            | "evidence", semantic-ref, ";"
            | typed-predicate-decl ;
(* RFC-1 (grammar stack 1.14): a typed predicate — a bare boolean field, or a typed comparison/
   logical `<left> <op> <right>`. Type-checked to boolean (condition) with compatible operands.
   Also usable as a `predicate` qualifier on a relationship. Projects onto `predicate`. *)
typed-predicate-decl = "predicate", ( identifier | identifier, predicate-op, scalar ), ";" ;
predicate-op = "gt" | "lt" | "ge" | "le" | "eq" | "ne" | "and" | "or" ;
policy-decl = "policy", identifier, "{", "authority", semantic-ref, ";",
              "rule", semantic-ref, ";", { "rule", semantic-ref, ";" },
              [ "default-conflict", conflict-strategy, ";" ],
              { knowledge-metadata }, "}" ;
rule-kind = "CONSTRAINT" | "PERMISSION" | "PROHIBITION" | "OBLIGATION"
          | "ELIGIBILITY" | "CLASSIFICATION" | "DERIVATION" | "DECISION"
          | "EXCEPTION" ;
normative-mode = "PERMISSION" | "PROHIBITION" | "OBLIGATION"
               | "RECOMMENDATION" | "DISCRETION" ;
conflict-strategy = "priority" | "specificity" | "authority" | "latest"
                  | "deny-overrides" | "permit-overrides" | "explicit" ;

reasoning-decl = "reasoning", identifier, "{", "kind", reasoning-kind, ";",
                 "proposition", scalar, ";", "method", reasoning-method, ";",
                 { reasoning-member | knowledge-metadata }, "}" ;
reasoning-member = "premise", semantic-ref, ";"
                 | "evidence", semantic-ref, ";"
                 | "conclusion", scalar, ";"
                 | "confidence", number, ";"
                 | "assumption", scalar, ";"
                 | "contradiction", semantic-ref, ";"
                 | "alternative", semantic-ref, ";" ;
reasoning-kind = "CLAIM" | "FACT" | "HYPOTHESIS" | "ASSUMPTION"
               | "INFERENCE" | "EXPLANATION" | "RECOMMENDATION"
               | "CONTRADICTION" ;
reasoning-method = "DEDUCTIVE" | "INDUCTIVE" | "ABDUCTIVE" | "CAUSAL"
                 | "PROBABILISTIC" | "ANALOGICAL" | "CONSTRAINT_BASED" ;

assertion-decl = "assertion", identifier, "{",
                 "subject", semantic-ref, ";", "predicate", scalar, ";",
                 ( "object", scalar | "object-ref", semantic-ref ), ";",
                 "status", epistemic-status, ";",
                 { assertion-member | knowledge-metadata }, "}" ;
assertion-member = "supersedes", semantic-ref, ";"
                 | "contradicts", semantic-ref, ";"
                 | "derived-by", semantic-ref, ";" ;
epistemic-status = "asserted" | "inferred" | "disputed" | "superseded"
                 | "retracted" | "unknown" ;

identity-resolution-decl = "identity-resolution", identifier, "{",
                           "canonical", semantic-ref, ";",
                           { identity-member | knowledge-metadata }, "}" ;
identity-member = "alias", scalar, ";"
                | "external-id", scalar, ";"
                | "same-as", semantic-ref, ";"
                | "merge-source", semantic-ref, ";"
                | "split-target", semantic-ref, ";"
                | "status", identity-status, ";" ;
identity-status = "active" | "merged" | "split" | "retired" ;

knowledge-query-decl = "knowledge-query", identifier, "{",
                       "select", identifier, ";", "where", scalar, ";",
                       "world", world-assumption, ";",
                       "negation", negation-policy, ";",
                       "inference", inference-policy, ";",
                       "temporal", temporal-query-policy, ";",
                       [ "as-of", scalar, ";" ], "}" ;
world-assumption = "open" | "closed" ;
negation-policy = "explicit" | "failure" ;
inference-policy = "none" | "declared" | "materialized" ;
temporal-query-policy = "current" | "as-of" | "all-history" ;

knowledge-metadata = "valid-from", scalar, ";"
                   | "valid-to", scalar, ";"
                   | "recorded-at", scalar, ";"
                   | "source-document", scalar, ";"
                   | "source-location", scalar, ";"
                   | "extraction-method", identifier, ";"
                   | "extraction-model", scalar, ";"
                   | "confidence", number, ";"
                   | "reviewed-by", semantic-ref, ";"
                   | "evidence", semantic-ref, ";"
                   | "classification", identifier, ";"
                   | "access-policy", semantic-ref, ";" ;
validity-inline = "valid-from", scalar, [ "valid-to", scalar ] ;

relationship-decl = "relationship", identifier, ":", identifier,
                    semantic-ref, "->", semantic-ref,
                    { identifier, scalar }, ";" ;
lifecycle-decl = "lifecycle", identifier, [ "for", semantic-ref ], "{",
                 lifecycle-member, { lifecycle-member }, "}" ;
lifecycle-member = state-decl | transition-decl
                 | "governs-kind", identifier, ";"
                 | "invariant", scalar, ";"
                 | "temporal", semantic-ref, ";" ;
state-decl = ( "initial" | "terminal" ), identifier, ";"
           | "state", identifier, ";"
           | "state", identifier, "{", { state-member }, "}" ;
state-member = "entry", semantic-ref, ";" | "exit", semantic-ref, ";"
             | "invariant", scalar, ";" ;
transition-decl = "transition", identifier, "->", identifier,
                  [ "using", semantic-ref ],
                  ( ";" | "{", { transition-member }, "}" ) ;
transition-member = "trigger", semantic-ref, ";" | "requires-work", semantic-ref, ";"
                  | "guard", scalar, ";" | "effect", semantic-ref, ";" ;

action-decl = action-effect, identifier, "{", action-member,
              { action-member }, "}" ;
action-effect = "command" | "query" | "transform" ;
action-member = field-mapping | invoke-decl | identifier, scalar, ";" ;
(* RFC-3 (grammar stack 1.15): an action-to-action invocation contract. The target must resolve to one
   canonical action; the caller must cover its required inputs, handle its failure modes, establish its
   preconditions, and be transaction-compatible; direct recursion must be `bounded`. *)
invoke-decl = "invoke", identifier, "{",
              { "arg", identifier, ";" | "handles", scalar, ";" | "establishes", scalar, ";"
              | "expects", scalar, ";" | "bounded", ";" }, "}" ;
(* RFC-2 (grammar stack 1.12): typed field-level lineage on a transform. Maps a source
   field path to a target field path, optionally with a conversion function, null
   behavior, a source->target unit pair, or a `lossy` marker. A field path is an
   identifier, dotted for `Entity.field`. Projects onto action `fieldMappings` in the IR. *)
field-mapping = "map", field-path, "->", field-path, { map-clause }, ";" ;
map-clause = "via", scalar
           | "null", null-behavior
           | "unit", identifier, "->", identifier
           | "lossy" ;
field-path = identifier ;
null-behavior = "propagate" | "default" | "error" ;
collection-decl = "collection", identifier, "{", collection-member,
                  { collection-member }, "}" ;
collection-member = identifier, scalar, ";" ;

identifier = ? KCF identifier ? ;
qualified-name = ? KCF qualified-name ? ;
semantic-ref = ? KCF semantic-ref ? ;
scalar = ? KCF scalar ? ;
number = ? KCF number ? ;
integer = ? KCF integer ? ;
