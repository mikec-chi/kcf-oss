{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcf.dev/schemas/assess-report-v1.schema.json",
  "title": "KCF Model Readiness Report v1",
  "description": "One unified readiness verdict aggregating validity, coverage, pattern proof, and role resolution - so the self-check loop is one command, not four.",
  "type": "object",
  "required": ["assessReportVersion", "model", "valid", "ready", "checks"],
  "properties": {
    "assessReportVersion": {"const": "1.0.0"},
    "model": {"type": "string"},
    "valid": {"type": "boolean"},
    "ready": {"type": "boolean"},
    "coverageStatus": {
      "enum": ["invalid", "no-substantive-content", "anchors-missing", "required-obligations-met", "profile-obligations-complete"],
      "description": "A richer coverage verdict than the lone `ready` boolean: what kind of readiness holds."
    },
    "readyFor": {
      "type": "array",
      "items": {"type": "string"},
      "description": "The downstream steps this model is ready for (e.g. codegen-handoff, review)."
    },
    "domainComplete": {
      "enum": ["not-proven"],
      "description": "Always 'not-proven': coverage obligations are necessary, never sufficient, for real domain completeness - that is a human judgement, not a machine verdict."
    },
    "checks": {
      "type": "object",
      "required": ["validity", "coverage", "patterns", "roles"],
      "properties": {
        "validity": {
          "type": "object",
          "required": ["valid", "errorRuleIds"],
          "properties": {"valid": {"type": "boolean"}, "errorRuleIds": {"type": "array", "items": {"type": "string"}}},
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "required": ["requiredGaps", "recommendedGaps"],
          "properties": {"requiredGaps": {"type": "integer"}, "recommendedGaps": {"type": "integer"}, "requiredGapIds": {"type": "array", "items": {"type": "string"}}},
          "additionalProperties": false
        },
        "patterns": {
          "type": "object",
          "required": ["satisfied", "requiredButAbsent", "claimedButUnproven", "requiredWithoutContract"],
          "properties": {
            "satisfied": {"type": "integer"},
            "requiredButAbsent": {"type": "array", "items": {"type": "string"}},
            "claimedButUnproven": {"type": "array", "items": {"type": "string"}},
            "requiredWithoutContract": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "roles": {
          "type": "object",
          "required": ["unknownTraits"],
          "properties": {"unknownTraits": {"type": "array", "items": {"type": "string"}}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
