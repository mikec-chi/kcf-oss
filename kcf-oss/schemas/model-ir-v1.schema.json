{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcf.dev/schemas/model-ir-v1.schema.json",
  "title": "KCF Normalized Semantic IR v1",
  "type": "object",
  "required": [
    "$schema",
    "irVersion",
    "id",
    "module",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "irVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "module": {
      "const": "KCF"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requiredPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "recommendedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "prohibitedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "implementedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "excludedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "moduleVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "lifecycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycle"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "collectionTransforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      }
    },
    "information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "reasoning": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reasoning"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "identityResolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identityResolution"
      }
    },
    "knowledgeQueries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledgeQuery"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "calendars": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "propositions": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "predicates": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "math": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "emitters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "runtimeRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtimeBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "integration": {
      "$ref": "#/$defs/openObject"
    },
    "security": {
      "$ref": "#/$defs/openObject"
    },
    "lineage": {
      "$ref": "#/$defs/openObject"
    },
    "architecture": {
      "$ref": "#/$defs/openObject"
    },
    "experience": {
      "$ref": "#/$defs/openObject"
    },
    "design": {
      "$ref": "#/$defs/openObject"
    },
    "analytics": {
      "$ref": "#/$defs/openObject"
    },
    "ai": {
      "$ref": "#/$defs/openObject"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/openObject"
      }
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sourceSpan"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "patternId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "openObject": {
      "type": "object",
      "additionalProperties": true
    },
    "sourceSpan": {
      "type": "object",
      "required": [
        "source",
        "line",
        "column",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "default": {},
        "cardinality": {
          "type": "string"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "qualifiedName",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ENTITY",
            "ACTOR",
            "WORK",
            "EVENT",
            "LIFECYCLE",
            "RULE",
            "INFORMATION",
            "RESOURCE",
            "TEMPORAL",
            "SPATIAL",
            "ORGANIZATIONAL",
            "INTENT",
            "REASONING",
            "MEASURE",
            "LOGIC",
            "MATH"
          ]
        },
        "abstract": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/openObject"
              }
            ]
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/openObject"
        },
        "instances": {
          "type": "array"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresCapability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresSkill": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectsLifecycle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correlationKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conceptKind": {
          "type": "string"
        },
        "occurrenceTime": {
          "type": "string"
        },
        "detectionTime": {
          "type": "string"
        },
        "severity": {
          "type": ["string", "number"]
        },
        "expectedness": {
          "type": "string"
        },
        "matchCondition": {
          "type": ["string", "number"]
        },
        "compositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target", "cardinality"],
            "properties": {
              "name": {"type": "string"},
              "target": {"type": "string"},
              "cardinality": {"type": "string"},
              "orphan": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "namedReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target", "cardinality"],
            "properties": {
              "name": {"type": "string"},
              "target": {"type": "string"},
              "cardinality": {"type": "string"},
              "inverse": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "of"],
            "properties": {
              "name": {"type": "string"},
              "of": {"type": "string"},
              "identity": {"type": "string"},
              "orderBy": {"type": "string"},
              "constraints": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "lifecycleRef": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unitRef": {
          "type": "string"
        },
        "periodRef": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "aggregation": {
          "type": "string"
        },
        "threshold": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "tolerance": {
          "type": "number"
        },
        "roles": {
          "type": "array",
          "items": {"type": "string"}
        },
        "authorities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "responsibleFor": {
          "type": "array",
          "items": {"type": "string"}
        },
        "accountableFor": {
          "type": "array",
          "items": {"type": "string"}
        },
        "memberOf": {
          "type": "array",
          "items": {"type": "string"}
        },
        "availability": {
          "type": "string"
        },
        "communicationRef": {
          "type": "string"
        },
        "performers": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "outcomes": {"type": "array", "items": {"type": "string"}},
        "requiresResource": {"type": "array", "items": {"type": "string"}},
        "requiresTool": {"type": "array", "items": {"type": "string"}},
        "governedBy": {"type": "array", "items": {"type": "string"}},
        "triggeredBy": {"type": "array", "items": {"type": "string"}},
        "emits": {"type": "array", "items": {"type": "string"}},
        "compensateWith": {"type": "array", "items": {"type": "string"}},
        "temporalRefs": {"type": "array", "items": {"type": "string"}},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "postconditions": {"type": "array", "items": {"type": "string"}},
        "completions": {"type": "array", "items": {"type": "string"}},
        "failures": {"type": "array", "items": {"type": "string"}},
        "calculation": {"type": "string"},
        "desiredState": {"type": "string"},
        "successes": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "number"},
        "timeHorizon": {"type": "string"},
        "stakeholders": {"type": "array", "items": {"type": "string"}},
        "measures": {"type": "array", "items": {"type": "string"}},
        "tradeoffs": {"type": "array", "items": {"type": "object"}},
        "startValue": {"type": "string"},
        "endValue": {"type": "string"},
        "durationValue": {"type": "object"},
        "recurrence": {"type": ["string", "number"]},
        "calendarRef": {"type": "string"},
        "timezone": {"type": ["string", "number"]},
        "containedIn": {"type": "string"},
        "geometry": {"type": "object"},
        "adjacentTo": {"type": "array", "items": {"type": "string"}},
        "jurisdictions": {"type": "array", "items": {"type": "string"}},
        "spatialRoutes": {"type": "array", "items": {"type": "string"}},
        "spatialCapacities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "rootKind",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "rootKind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number"
        },
        "allowSelf": {
          "type": "boolean"
        },
        "qualifiers": {
          "$ref": "#/$defs/openObject"
        },
        "validFrom": {
          "type": "string"
        },
        "validTo": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "trigger": {"type": "array", "items": {"type": "string"}},
        "requiresWork": {"type": "array", "items": {"type": "string"}},
        "guard": {"type": "array", "items": {"type": "string"}},
        "effect": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "id",
        "states",
        "initial",
        "terminal",
        "transitions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "subject": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "initial": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "governsKind": {
          "type": "array",
          "items": {"type": "string"}
        },
        "invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "temporalRefs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stateBodies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "entry": {"type": "array", "items": {"type": "string"}},
              "exit": {"type": "array", "items": {"type": "string"}},
              "invariant": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "enum": [
            "query",
            "command",
            "transform"
          ]
        },
        "operation": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "inputCardinality": {
          "type": "string"
        },
        "outputCardinality": {
          "type": "string"
        },
        "idempotency": {
          "type": "string"
        },
        "atomicity": {
          "type": "string"
        },
        "concurrency": {
          "type": "string"
        },
        "authorization": {
          "type": "string"
        },
        "authorizationExemption": {
          "type": "string"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "knowledgeMetadata": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string"
        },
        "validTo": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        },
        "sourceDocument": {
          "type": "string"
        },
        "sourceLocation": {
          "type": "string"
        },
        "extractionMethod": {
          "type": "string"
        },
        "extractionModel": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewedBy": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "classification": {
          "type": "string"
        },
        "accessPolicy": {
          "type": "string"
        }
      }
    },
    "organization": {
      "type": "object",
      "required": [
        "id",
        "organizationKind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "organizationKind": {
          "enum": [
            "ORGANIZATION",
            "UNIT",
            "DEPARTMENT",
            "TEAM",
            "POSITION"
          ]
        },
        "parent": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "authorityDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "accountableFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reporting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "validFrom": {
                "type": "string"
              },
              "validTo": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "escalations": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/knowledgeMetadata"
        }
      ]
    },
    "information": {
      "type": "object",
      "required": [
        "id",
        "informationKind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "informationKind": {
          "enum": [
            "DOCUMENT",
            "MESSAGE",
            "RECORD",
            "MODEL",
