{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcf.dev/schemas/model-ir-v1.schema.json",
  "title": "KCF Normalized Semantic IR v1",
  "type": "object",
  "required": [
    "$schema",
    "irVersion",
    "id",
    "module",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "irVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "module": {
      "const": "KCF"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "packageKind": {
      "type": "string",
      "description": "Optional declaration of what this package is (e.g. 'vocabulary' for a definitions-only term library). A 'vocabulary' package is exempt from the substantive-content and profile-anchor coverage obligations. Additive/optional: absence changes nothing."
    },
    "requiredPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "recommendedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "prohibitedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "implementedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "excludedPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternId"
      },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "moduleVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "lifecycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycle"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "collectionTransforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      }
    },
    "information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "reasoning": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reasoning"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "identityResolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identityResolution"
      }
    },
    "knowledgeQueries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledgeQuery"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "calendars": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "propositions": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "predicates": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "math": {"type": "array", "items": {"$ref": "#/$defs/openObject"}},
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "emitters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "runtimeRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtimeBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openObject"
      }
    },
    "integration": {
      "$ref": "#/$defs/openObject"
    },
    "security": {
      "$ref": "#/$defs/openObject"
    },
    "lineage": {
      "$ref": "#/$defs/openObject"
    },
    "architecture": {
      "$ref": "#/$defs/openObject"
    },
    "experience": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "kind": {
                "description": "RFC-15: the view projection. Optional; absent → list/detail. Per-kind bindings (parent/column/series/geometry/start/end/depends-on/tile/renderer) point at existing semantic dimensions and are validated by the analyzer (experience.view.binding).",
                "enum": ["list", "form", "tree", "chart", "dashboard", "map", "kanban", "gantt", "custom"]
              }
            }
          }
        }
      }
    },
    "design": {
      "$ref": "#/$defs/openObject"
    },
    "analytics": {
      "$ref": "#/$defs/openObject"
    },
    "ai": {
      "$ref": "#/$defs/openObject"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/openObject"
      }
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sourceSpan"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "patternId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "openObject": {
      "type": "object",
      "additionalProperties": true
    },
    "sourceSpan": {
      "type": "object",
      "required": [
        "source",
        "line",
        "column",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "default": {},
        "cardinality": {
          "type": "string"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "qualifiedName",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ENTITY",
            "ACTOR",
            "WORK",
            "EVENT",
            "LIFECYCLE",
            "RULE",
            "INFORMATION",
            "RESOURCE",
            "TEMPORAL",
            "SPATIAL",
            "ORGANIZATIONAL",
            "INTENT",
            "REASONING",
            "MEASURE",
            "LOGIC",
            "MATH"
          ]
        },
        "abstract": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/openObject"
              }
            ]
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/openObject"
        },
        "instances": {
          "type": "array"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresCapability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresSkill": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectsLifecycle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correlationKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conceptKind": {
          "type": "string"
        },
        "occurrenceTime": {
          "type": "string"
        },
        "detectionTime": {
          "type": "string"
        },
        "severity": {
          "type": ["string", "number"]
        },
        "expectedness": {
          "type": "string"
        },
        "matchCondition": {
          "type": ["string", "number"]
        },
        "compositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target", "cardinality"],
            "properties": {
              "name": {"type": "string"},
              "target": {"type": "string"},
              "cardinality": {"type": "string"},
              "orphan": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "namedReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target", "cardinality"],
            "properties": {
              "name": {"type": "string"},
              "target": {"type": "string"},
              "cardinality": {"type": "string"},
              "inverse": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "of"],
            "properties": {
              "name": {"type": "string"},
              "of": {"type": "string"},
              "identity": {"type": "string"},
              "orderBy": {"type": "string"},
              "constraints": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "lifecycleRef": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unitRef": {
          "type": "string"
        },
        "periodRef": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "aggregation": {
          "type": "string"
        },
        "threshold": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "tolerance": {
          "type": "number"
        },
        "roles": {
          "type": "array",
          "items": {"type": "string"}
        },
        "authorities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "responsibleFor": {
          "type": "array",
          "items": {"type": "string"}
        },
        "accountableFor": {
          "type": "array",
          "items": {"type": "string"}
        },
        "memberOf": {
          "type": "array",
          "items": {"type": "string"}
        },
        "availability": {
          "type": "string"
        },
        "communicationRef": {
          "type": "string"
        },
        "performers": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "outcomes": {"type": "array", "items": {"type": "string"}},
        "requiresResource": {"type": "array", "items": {"type": "string"}},
        "requiresTool": {"type": "array", "items": {"type": "string"}},
        "governedBy": {"type": "array", "items": {"type": "string"}},
        "triggeredBy": {"type": "array", "items": {"type": "string"}},
        "emits": {"type": "array", "items": {"type": "string"}},
        "compensateWith": {"type": "array", "items": {"type": "string"}},
        "temporalRefs": {"type": "array", "items": {"type": "string"}},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "postconditions": {"type": "array", "items": {"type": "string"}},
        "completions": {"type": "array", "items": {"type": "string"}},
        "failures": {"type": "array", "items": {"type": "string"}},
        "calculation": {"type": "string"},
        "desiredState": {"type": "string"},
        "successes": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "number"},
        "timeHorizon": {"type": "string"},
        "stakeholders": {"type": "array", "items": {"type": "string"}},
        "measures": {"type": "array", "items": {"type": "string"}},
        "tradeoffs": {"type": "array", "items": {"type": "object"}},
        "startValue": {"type": "string"},
        "endValue": {"type": "string"},
        "durationValue": {"type": "object"},
        "recurrence": {"type": ["string", "number"]},
        "calendarRef": {"type": "string"},
        "timezone": {"type": ["string", "number"]},
        "containedIn": {"type": "string"},
        "specializes": {"type": "string", "description": "RFC-8: the concept this one specializes/refines; its primary kind must be preserved or legally refined."},
        "geometry": {"type": "object"},
        "adjacentTo": {"type": "array", "items": {"type": "string"}},
        "jurisdictions": {"type": "array", "items": {"type": "string"}},
        "spatialRoutes": {"type": "array", "items": {"type": "string"}},
        "spatialCapacities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "rootKind",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "rootKind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number"
        },
        "allowSelf": {
          "type": "boolean"
        },
        "qualifiers": {
          "$ref": "#/$defs/openObject"
        },
        "validFrom": {
          "type": "string"
        },
        "validTo": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "trigger": {"type": "array", "items": {"type": "string"}},
        "requiresWork": {"type": "array", "items": {"type": "string"}},
        "guard": {"type": "array", "items": {"type": "string"}},
        "effect": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "id",
        "states",
        "initial",
        "terminal",
        "transitions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "subject": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "initial": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "governsKind": {
          "type": "array",
          "items": {"type": "string"}
        },
        "invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "temporalRefs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stateBodies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "entry": {"type": "array", "items": {"type": "string"}},
              "exit": {"type": "array", "items": {"type": "string"}},
              "invariant": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "enum": [
            "query",
            "command",
            "transform"
          ]
        },
        "operation": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "inputCardinality": {
          "type": "string"
        },
        "outputCardinality": {
          "type": "string"
        },
        "idempotency": {
          "type": "string"
        },
        "atomicity": {
          "type": "string"
        },
        "concurrency": {
          "type": "string"
        },
        "authorization": {
          "type": "string"
        },
        "authorizationExemption": {
          "type": "string"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "IR 1.1 executable contract: conditions that must hold BEFORE the action may run (pre-state)."
        },
        "postconditions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "IR 1.1 executable contract: conditions guaranteed AFTER the action succeeds (post-state)."
        },
        "expectedVersion": {
          "type": "string",
          "description": "IR 1.1: the optimistic-concurrency / row-version token an update must match to prevent lost updates."
        },
        "idempotencyKey": {
          "type": "string",
          "description": "IR 1.1: the field/expression that makes a command idempotent under retry (dedup key)."
        },
        "transactionBoundary": {
          "enum": ["required", "requires-new", "supported", "not-supported", "none"],
          "description": "IR 1.1: the transaction boundary this action participates in."
        },
        "compensation": {
          "type": "string",
          "description": "IR 1.1: the id of a compensating action that reverses this one (required when reversibility is 'compensatable')."
        },
        "reversibility": {
          "enum": ["reversible", "compensatable", "irreversible", "human-recoverable"],
          "description": "IR 1.1: whether the action's effect can be undone, and how."
        },
        "deleteBehavior": {
          "enum": ["hard", "soft", "restrict", "cascade", "archive"],
          "description": "IR 1.1: for a delete operation, how the record and its dependents are removed/retained."
        },
        "retention": {
          "type": "string",
          "description": "IR 1.1: the retention/recovery policy for data affected by a destructive action."
        },
        "bulkLimit": {
          "type": "integer",
          "minimum": 1,
          "description": "IR 1.1: the maximum number of items a set/bulk operation may process in one call."
        },
        "bulkOrdering": {
          "enum": ["ordered", "unordered"],
          "description": "IR 1.1: whether a set/bulk operation must process items in order."
        },
        "bulkFailurePolicy": {
          "enum": ["fail-fast", "continue", "atomic", "best-effort"],
          "description": "IR 1.1: how a set/bulk operation handles a partial failure across items."
        },
        "fieldMappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/fieldMapping"},
          "description": "RFC-2 (additive, optional): typed field-level lineage for a transform. When present, every required field of each output must be covered and each mapping must be type/unit/null consistent."
        },
        "provides": {
          "type": "array",
          "items": {"type": "string"},
          "description": "RFC-3 (additive, optional): the client-supplied input field names of a create/update; enforced against the target's required + read-only fields when present."
        },
        "patchDialect": {
          "type": "string",
          "description": "RFC-3: the patch dialect a `patch` operation uses (e.g. json-patch, merge-patch)."
        },
        "returns": {
          "enum": ["records", "keys", "count", "per-item", "none"],
          "description": "RFC-3: the result shape a set/bulk operation returns."
        },
        "pagination": {
          "enum": ["page", "cursor", "stream", "bounded", "none"],
          "description": "RFC-3: the pagination/streaming/bounded-materialization behavior of a large query."
        },
        "retryBackoff": {"type": "string", "description": "RFC-4: the bounded backoff policy of a retrying action."},
        "retryClassification": {"type": "string", "description": "RFC-4: which failure classes (transient/permanent) a retry applies to."},
        "totality": {"enum": ["total", "partial"], "description": "RFC-2: whether a transform's field mapping is total (covers all) or partial."},
        "invocations": {
          "type": "array",
          "description": "RFC-3: action-to-action invocation contracts.",
          "items": {
            "type": "object",
            "required": ["target"],
            "properties": {
              "target": {"type": "string"},
              "args": {"type": "array", "items": {"type": "string"}},
              "handles": {"type": "array", "items": {"type": "string"}},
              "establishes": {"type": "array", "items": {"type": "string"}},
              "expects": {"type": "string"},
              "bounded": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "fieldMapping": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": {"type": "string", "description": "Source field path (Entity.field or field) read by the transform."},
        "target": {"type": "string", "description": "Target field path (Entity.field or field) the transform writes."},
        "function": {"type": "string", "description": "Optional named/inline transformation applied from source to target (identity when absent)."},
        "nullBehavior": {"enum": ["propagate", "default", "error"], "description": "How a null/absent source is handled when writing the target."},
        "sourceUnit": {"type": "string", "description": "Unit of the source quantity (from the type-system unit registry)."},
        "targetUnit": {"type": "string", "description": "Unit of the target quantity; must be compatible with sourceUnit or reconciled by `function`."},
        "lossy": {"type": "boolean", "description": "The mapping intentionally narrows/drops precision or data (acknowledges an otherwise-flagged loss)."}
      },
      "additionalProperties": true
    },
