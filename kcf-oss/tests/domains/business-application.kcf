kcf model CustomerService profile business-application {
  namespace customer;

  entity Customer {
    identity customerId: UUID;
    required name: String;
    optional email: String;
  }

  actor ServiceAgent { }
  work UpdateCustomerWork { }
  event CustomerUpdated immutable;

  relationship agent-performs-update: PARTICIPATION ServiceAgent -> UpdateCustomerWork strength 1.0;
  relationship update-changes-customer: TRANSFORMATION UpdateCustomerWork -> Customer strength 1.0;

  lifecycle CustomerLifecycle for Customer {
    initial Active;
    state Suspended;
    terminal Archived;
    transition Active -> Suspended;
    transition Suspended -> Active;
    transition Active -> Archived;
  }

  command UpdateCustomer {
    operation update;
    scope record;
    target Customer;
    selection identity;
    input one;
    output one;
    mutate name;
    idempotency conditional;
    atomicity atomic;
    concurrency optimistic;
    authorization customer.CustomerUpdatePolicy;
    expected-version rowVersion;
    idempotency-key requestId;
  }

  command CreateCustomer {
    operation create;
    scope record;
    target Customer;
    input one;
    output one;
    idempotency conditional;
    atomicity atomic;
    authorization customer.CustomerUpdatePolicy;
    idempotency-key requestId;
  }

  query GetCustomer {
    operation read;
    scope record;
    target Customer;
    selection identity;
    input one;
    output one;
  }

  command DeleteCustomer {
    operation delete;
    scope record;
    target Customer;
    selection identity;
    input one;
    output zero;
    idempotency conditional;
    atomicity atomic;
    authorization customer.CustomerUpdatePolicy;
    idempotency-key requestId;
    delete-behavior soft;
    reversibility human-recoverable;
    retention "retain soft-deleted customers for 30 days";
    expected-version rowVersion;
  }

  command BulkUpdateCustomers {
    operation bulk-update;
    scope set;
    target Customer;
    selection predicate;
    input many;
    output many;
    idempotency conditional;
    atomicity best-effort;
    concurrency optimistic;
    authorization customer.CustomerUpdatePolicy;
    expected-version rowVersion;
    idempotency-key requestId;
    bulk-limit 1000;
    bulk-ordering unordered;
    bulk-failure continue; returns count;
  }

  command UpsertCustomer {
    operation upsert;
    scope record;
    target Customer;
    selection identity;
    input one;
    output one;
    idempotency conditional;
    atomicity atomic;
    authorization customer.CustomerUpdatePolicy;
    concurrency optimistic;
    expected-version rowVersion;
    idempotency-key requestId;
  }

  collection ActiveCustomers {
    operation filter;
    inputSchema Customer;
    outputSchema Customer;
    predicate "customer status is Active";
    bounded true;
  }

  rule CustomerUpdateConstraint {
    kind CONSTRAINT;
    condition "email is present when a customer is Active";
    effect UpdateCustomerWork;
    applies-to Customer;
    authority ServiceAgent;
  }

  policy CustomerUpdatePolicy {
    authority ServiceAgent;
    rule CustomerUpdateConstraint;
    default-conflict deny-overrides;
  }
}
