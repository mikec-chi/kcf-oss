    {
      "id": "IsUnderpriced",
      "qualifiedName": "qp.IsUnderpriced",
      "parameters": [
        {
          "name": "product",
          "type": "UUID"
        }
      ],
      "expression": "price below cost"
    }
  ],
  "math": [
    {
      "id": "MarginFormula",
      "qualifiedName": "qp.MarginFormula",
      "mathKind": "formula",
      "result": "qp.RevenueKPI",
      "expression": {
        "op": "-",
        "left": {
          "ref": "price"
        },
        "right": {
          "op": "*",
          "left": {
            "ref": "cost"
          },
          "right": {
            "ref": "quantity"
          }
        }
      }
    },
    {
      "id": "UnitMargin",
      "qualifiedName": "qp.UnitMargin",
      "mathKind": "function",
      "parameters": [
        {
          "name": "cost",
          "type": "Decimal"
        },
        {
          "name": "price",
          "type": "Decimal"
        }
      ],
      "returns": "Decimal",
      "expression": {
        "op": "-",
        "left": {
          "ref": "price"
        },
        "right": {
          "ref": "cost"
        }
      }
    },
    {
      "id": "MaximizeMargin",
      "qualifiedName": "qp.MaximizeMargin",
      "mathKind": "optimize",
      "objective": {
        "direction": "maximize",
        "expression": {
          "op": "-",
          "left": {
            "ref": "revenue"
          },
          "right": {
            "ref": "cost"
          }
        }
      },
      "variables": [
        "price"
      ],
      "constraints": [
        "price is at least cost"
      ]
    },
    {
      "id": "DemandModel",
      "qualifiedName": "qp.DemandModel",
      "mathKind": "distribution",
      "family": "normal",
      "qualifiers": {
        "mean": 100,
        "stddev": 15
      }
    },
    {
      "id": "DemandSim",
      "qualifiedName": "qp.DemandSim",
      "mathKind": "simulation",
      "model": "qp.MaximizeMargin",
      "trials": 1000,
      "seed": 42
    }
  ],
