{
  "$schema": "../../../schemas/model-ir-v1.schema.json",
  "irVersion": "1.0.0",
  "id": "Transportation",
  "module": "KCF",
  "concepts": [
    {
      "id": "Shipment",
      "qualifiedName": "transport.Shipment",
      "kind": "ENTITY",
      "references": [],
      "attributes": [
        {"name": "trackingCode", "type": "string", "required": true}
      ]
    },
    {"id": "LoadPlanner", "qualifiedName": "transport.LoadPlanner", "kind": "ACTOR", "references": []},
    {"id": "TenderLoad", "qualifiedName": "transport.TenderLoad", "kind": "WORK", "references": ["transport.Shipment", "transport.LoadPlanner"]},
    {"id": "TenderSent", "qualifiedName": "transport.TenderSent", "kind": "EVENT", "references": ["transport.Shipment"]},
    {"id": "Carrier", "qualifiedName": "transport.Carrier", "kind": "ACTOR", "references": []}
  ],
  "relationships": [
    {"id": "planner-performs-tender", "definition": "performs", "rootKind": "PARTICIPATION", "source": "transport.LoadPlanner", "target": "transport.TenderLoad", "strength": 1.0},
    {"id": "tender-operates-shipment", "definition": "operatesOn", "rootKind": "TRANSFORMATION", "source": "transport.TenderLoad", "target": "transport.Shipment", "strength": 1.0}
  ],
  "lifecycles": [
    {"id": "ShipmentLifecycle", "states": ["Ready", "Tendered", "Assigned"], "initial": "Ready", "terminal": ["Assigned"], "transitions": [{"from": "Ready", "to": "Tendered"}, {"from": "Tendered", "to": "Assigned"}]}
  ],
  "actions": [
    {"id": "AssignCarrier", "effect": "command", "operation": "update", "scope": "record", "target": "transport.Shipment", "selection": "identity", "inputCardinality": "one", "outputCardinality": "one", "idempotency": "conditional", "atomicity": "atomic", "authorization": "system.AssignmentPolicy"}
  ],
  "events": [{"id": "TenderSent", "mutable": false}],
  "resources": [{"id": "PlannerCapacity", "capacity": 10}],
  "allocations": [{"id": "Allocation1", "resource": "PlannerCapacity", "quantity": 2}],
  "plans": [{"id": "TenderPlan", "steps": [{"index": 1}, {"index": 2}]}],
  "runtimeRequirements": ["ResolvePerformer", "ValidatePreconditions", "EnforceTrackingCode"],
  "emitters": [{"id": "WorkflowEmitter", "supports": ["ResolvePerformer", "ValidatePreconditions", "EnforceTrackingCode"], "unsupportedPolicy": "error"}],
  "runtimeBindings": [{"id": "ResolvePerformer", "version": "1.0.0"}]
}
