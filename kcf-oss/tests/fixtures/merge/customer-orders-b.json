{
  "$schema": "../schemas/model-ir-v1.schema.json",
  "irVersion": "1.0.0",
  "id": "CommerceCatalog",
  "module": "KCF",
  "namespace": "shop",
  "modules": ["KCF"],
  "concepts": [
    {"id": "Customer", "qualifiedName": "shop.Customer", "kind": "ENTITY", "attributes": [
      {"name": "customerId", "type": "UUID", "identity": true},
      {"name": "email", "type": "String"}
    ]},
    {"id": "Product", "qualifiedName": "shop.Product", "kind": "ENTITY", "attributes": [
      {"name": "sku", "type": "String", "identity": true}
    ]}
  ],
  "relationships": [
    {"id": "order-contains-product", "rootKind": "COMPOSITION", "source": "shop.Order", "target": "shop.Product"}
  ]
}
